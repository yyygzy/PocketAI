{
  "name": "pocket-ai",
  "version": "1.2.7",
  "description": "墨匣 (Moxia) - 本地优先可随身携带的 AI 工作台",
  "main": "out/main/index.js",
  "author": "Moxia",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyygzy/PocketAI.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:update-yml": "node scripts/check-update-yml.cjs dist",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:nsis": "electron-vite build && electron-builder --win nsis",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.linux.yml",
    "license": "node scripts/license-studio.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cheerio": "^1.2.0",
    "electron-store": "^8.2.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.3",
    "mermaid": "^11.17.2",
    "pdf-parse": "^2.4.5",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unzipper": "^0.12.5",
    "webdav": "^5.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^4.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "ai.pocket.desktop",
    "productName": "Moxia",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**/*.node"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "extensions/**/*",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.cache",
      "!**/node_modules/{@types,typescript}",
      "!**/node_modules/{better-sqlite3-multiple-ciphers}/prebuilds/{darwin,linux,linuxmusl}-*.node"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Moxia-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moxia",
      "perMachine": false
    },
    "portable": {
      "artifactName": "Moxia-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Moxia-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "yyygzy",
      "repo": "PocketAI",
      "channel": "latest"
    }
  }
}
